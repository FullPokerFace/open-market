# Copy to .env.local and fill in your own values. Never commit .env.local.

# Required: earnings calendar, company listings and EPS history (free key at https://finnhub.io)
FINNHUB_API_KEY=your_finnhub_key

# Required: MongoDB Atlas user for the cluster in src/lib/db.js, where everything fetched is saved
MONGO_DB_USER=your_mongo_user
MONGO_DB_PASSWORD=your_mongo_password

# Optional: the "Suggest a feature" board (moderation and card titles by OpenAI).
# Without it, posting a suggestion says "temporarily unavailable"; the board still loads.
OPEN_AI_KEY=your_openai_key

# Optional: company logos on the calendar tiles (free key at https://logo.dev). `npm run logos:sync` saves them
# to public/logos; until a logo is there, browsers are sent to logo.dev's image, so this must be the publishable
# pk_ key, never sk_.
# Without it, tiles show tickers and the tickers / logos toggle is hidden.
LOGO_DEV_TOKEN=pk_your_logo_dev_key

# Optional: emails each suggestion to you through Gmail SMTP (needs a Google app password)
GMAIL_SENDER_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Optional: earnings notifications (Watchlists page "Notify"). Sign-in is only needed for these: visitors get a
# 6-digit code by email, and each weekday at 6 AM ET a cron job emails them the companies reporting that day.
# Without these, signing in and notifications don't work; everything else does.
# Resend API key (https://resend.com/api-keys), and the sender on a domain verified in Resend
RESEND_API_KEY=
EMAIL_FROM="Open Market <notifications@getopenmarket.app>"
# Random secret for sign-in sessions and unsubscribe links, 32+ characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The site's address: http://localhost:3000 locally, https://www.getopenmarket.app in production
BETTER_AUTH_URL=http://localhost:3000
# Random secret Vercel sends to /api/cron/earnings-digest; set the same value in the Vercel project settings
CRON_SECRET=

# Optional: the admin panel at /admin (user list). Without it, /admin/login says admin isn't set up.
ADMIN_PASSWORD=

# Optional: who the SEC sees in the User-Agent header; defaults to "EarningsReport/0.1 (https://iwan-web.com)"
# SEC_USER_AGENT=YourApp/1.0 (you@example.com)

# Optional: the live site for `npm run test:e2e:live` and `npm run test:e2e:live:ui`
E2E_LIVE_URL=https://your-domain.com
